{
    "name": "le-fanion-app",
    "version": "0.1.0",
    "description": "Application de gestion scolaire - École Le Fanion",
    "main": "dist-electron/main.js",
    "private": true,
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build && electron-builder",
        "build:renderer": "vite build",
        "electron:dev": "tsc -p tsconfig.electron.json && node -e \"require('fs').cpSync('electron/db/migrations','dist-electron/db/migrations',{recursive:true})\" && electron .",
        "db:migrate": "ts-node electron/db/migrate.ts"
    },
    "dependencies": {
        "better-sqlite3": "^11.3.0",
        "date-fns": "^3.6.0",
        "docxtemplater": "^3.50.0",
        "pdf-lib": "^1.17.1",
        "pizzip": "^3.1.7",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-hook-form": "^7.52.2",
        "react-router-dom": "^6.26.1",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.11",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.1",
        "autoprefixer": "^10.4.20",
        "electron": "^31.3.1",
        "electron-builder": "^24.13.3",
        "postcss": "^8.4.41",
        "tailwindcss": "^3.4.9",
        "typescript": "^5.5.4",
        "vite": "^5.4.1"
    }
}