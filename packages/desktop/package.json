{
  "name": "@fanion/desktop",
  "version": "0.1.0",
  "description": "Application de bureau de gestion scolaire - École Le Fanion",
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron && electron-builder",
    "electron:dev": "tsc -p tsconfig.electron.json && electron ."
  },
  "build": {
    "appId": "cm.lefanion.desktop",
    "productName": "Le Fanion",
    "copyright": "Copyright © 2026 École Le Fanion",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build-resources/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build-resources/icon.ico",
      "uninstallerIcon": "build-resources/icon.ico",
      "installerHeaderIcon": "build-resources/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Le Fanion"
    },
    "mac": {
      "icon": "build-resources/icon.icns",
      "target": "dmg"
    },
    "linux": {
      "icon": "build-resources/icon.png",
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@fanion/shared": "*",
    "date-fns": "^3.6.0",
    "docxtemplater": "^3.50.0",
    "pdf-lib": "^1.17.1",
    "pizzip": "^3.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.2",
    "react-router-dom": "^6.26.1",
    "recharts": "^3.10.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "31.7.7",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.9",
    "typescript": "^5.5.4",
    "vite": "^5.4.1"
  }
}
